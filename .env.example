# API Configuration
# Override the API origin for both server and client (optional)
# API_URL=http://localhost:8080
# Override the API origin for the client bundle only (optional).
# Routes browser-side fetches (SWR hooks) to a different origin than the server.
# NEXT_PUBLIC_API_URL=http://localhost:8081
# Used in constants/api-config.ts
NEXT_PUBLIC_API_REVALIDATION=3600

# CDN Configuration (optional)
NEXT_PUBLIC_CDN_URL=

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=
